# YouTube Data API v3 key
# https://console.cloud.google.com/ 에서 발급
YOUTUBE_API_KEY=your_youtube_api_key_here

# Groq API key (무료) - https://console.groq.com/ 에서 발급
GROQ_API_KEY=your_groq_api_key_here

# 분석할 유튜브 채널 (@핸들 또는 UC로 시작하는 채널 ID 모두 가능)
CHANNEL_ID=@hk_koreamarket

# 수집 기간 (일수, 기본 365일 = 1년)
DAYS_TO_FETCH=365

# 한국투자증권(KIS) Open API - https://apiportal.koreainvestment.com 에서 발급
# 계좌 개설 후 my page에서 앱키/앱시크릿 발급 (모의투자 계좌도 가능)
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
# real(실전투자) 또는 virtual(모의투자)
KIS_ENV=real

# --- 로컬 실시간 대시보드 (server.py) ---
# 실시간으로 볼 종목코드 (6자리, 콤마 구분). 예: 삼성전자, SK하이닉스
WATCHLIST=005930,000660
# 시세 갱신 주기 (초)
POLL_INTERVAL=3
# 외부(Tailscale Funnel 등)에 노출할 때 걸어둘 로그인 정보 - 반드시 설정하세요
DASHBOARD_USER=
DASHBOARD_PASS=
PORT=8080

# --- 매매 전략 (strategy.py) ---
MA_SHORT=5
MA_LONG=20
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
PRICE_CHANGE_ALERT_PCT=3
VOLUME_SPIKE_MULT=2

# --- 이메일 알림 (Gmail 기준, 2단계 인증 + 앱 비밀번호 필요) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_APP_PASSWORD=your_16_digit_app_password
EMAIL_TO=your_gmail@gmail.com

# --- 카카오톡 '나에게 보내기' 알림 ---
# developers.kakao.com에서 앱 생성 후 REST API 키 입력, kakao_auth.py로 최초 1회 인증 필요
KAKAO_ENABLED=false
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=https://localhost.com
