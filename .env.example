# YouTube Data API v3 key
# https://console.cloud.google.com/ 에서 발급
YOUTUBE_API_KEY=your_youtube_api_key_here

# Groq API key (무료) - https://console.groq.com/ 에서 발급
GROQ_API_KEY=your_groq_api_key_here

# 분석할 유튜브 채널 (@핸들 또는 UC로 시작하는 채널 ID 모두 가능)
CHANNEL_ID=@hk_koreamarket

# 수집 기간 (일수, 기본 365일 = 1년)
DAYS_TO_FETCH=365

# 한국투자증권(KIS) Open API - https://apiportal.koreainvestment.com 에서 발급
# 계좌 개설 후 my page에서 앱키/앱시크릿 발급 (모의투자 계좌도 가능)
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
# real(실전투자) 또는 virtual(모의투자)
KIS_ENV=real

# --- 로컬 실시간 대시보드 (server.py) ---
# 실시간으로 볼 종목코드 (6자리, 콤마 구분). 예: 삼성전자, SK하이닉스
WATCHLIST=005930,000660
# 시세 갱신 주기 (초)
POLL_INTERVAL=3
# 외부(Tailscale Funnel 등)에 노출할 때 걸어둘 로그인 정보 - 반드시 설정하세요
DASHBOARD_USER=
DASHBOARD_PASS=
PORT=8080
